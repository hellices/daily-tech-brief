{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Tech Brief issue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date", "generated_at", "headline", "summary", "coverage", "github_snapshot", "repositories", "papers", "discussions", "cncf"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision_note": {"$ref": "#/$defs/text"},
    "github_featured": {
      "description": "Editorially selected 2-3 repositories, or all when fewer than two qualify.",
      "type": "array", "maxItems": 3, "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "teams": {
      "type": "object", "additionalProperties": false,
      "required": ["spotlight", "highlights"],
      "properties": {
        "spotlight": {"type": "array", "minItems": 1, "maxItems": 3,
                      "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "highlights": {
          "type": "array", "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["section", "url", "text"],
            "properties": {
              "section": {"enum": ["github", "papers", "community", "cncf"]},
              "url": {"$ref": "#/$defs/url"},
              "text": {"type": "string", "minLength": 1, "maxLength": 160}
            }
          }
        }
      }
    },
    "lead": {
      "description": "Required for version 2: one current item that drives the headline and all three opening paragraphs. Null only when the issue has no items.",
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["section", "url"],
          "properties": {
            "section": {"enum": ["github", "papers", "community", "cncf"]},
            "url": {"$ref": "#/$defs/url"}
          }
        }
      ]
    },
    "date": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "headline": {"$ref": "#/$defs/text"},
    "summary": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/text"}},
    "coverage": {
      "type": "object",
      "required": ["github", "papers", "community", "cncf"],
      "additionalProperties": false,
      "properties": {
        "github": {"$ref": "#/$defs/coverage"},
        "papers": {"$ref": "#/$defs/coverage"},
        "community": {"$ref": "#/$defs/coverage"},
        "cncf": {"$ref": "#/$defs/coverage"}
      }
    },
    "github_snapshot": {"anyOf": [{"$ref": "#/$defs/snapshot"}, {"type": "null"}]},
    "github_previous_snapshot": {"$ref": "#/$defs/snapshot"},
    "repositories": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/repository"}},
    "papers": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/paper"}},
    "discussions": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/discussion"}},
    "cncf": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/change"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/url"}},
    "tags": {
      "description": "1-5 canonical IDs from tags.json. Required when staging new issues; optional only for legacy schema-v1 reports.",
      "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "note", "sources"],
      "properties": {
        "status": {"enum": ["ok", "partial", "unavailable"]},
        "note": {"$ref": "#/$defs/text"},
        "sources": {"$ref": "#/$defs/sources"}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["captured_at", "source", "entries"],
      "properties": {
        "captured_at": {"type": "string", "format": "date-time"},
        "source": {"const": "https://github.com/trending?since=weekly"},
        "entries": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["repository", "rank", "weekly_stars"],
            "properties": {
              "repository": {"$ref": "#/$defs/text"},
              "rank": {"type": "integer", "minimum": 1, "maximum": 10},
              "weekly_stars": {"type": ["integer", "null"], "minimum": 0}
            }
          }
        }
      }
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "url", "rank", "summary", "why_now", "use_case", "caution", "sources"],
      "properties": {
        "tags": {"$ref": "#/$defs/tags"},
        "repository": {"$ref": "#/$defs/text"},
        "url": {"$ref": "#/$defs/url"},
        "rank": {"type": "integer", "minimum": 1, "maximum": 10},
        "novelty": {"enum": ["first_observed", "new_entry", "first_introduction"]},
        "summary": {"$ref": "#/$defs/text"},
        "why_now": {"$ref": "#/$defs/text"},
        "use_case": {"$ref": "#/$defs/text"},
        "caution": {"$ref": "#/$defs/text"},
        "sources": {"$ref": "#/$defs/sources"}
      }
    },
    "paper": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "url", "first_published", "topics", "evidence", "abstract_summary", "method", "findings", "limitations", "practical_value", "sources"],
      "properties": {
        "tags": {"$ref": "#/$defs/tags"},
        "id": {"$ref": "#/$defs/text"},
        "title": {"$ref": "#/$defs/text"},
        "url": {"$ref": "#/$defs/url"},
        "first_published": {"type": "string", "format": "date"},
        "topics": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/text"}},
        "evidence": {"enum": ["full_text", "abstract_only"]},
        "abstract_summary": {"$ref": "#/$defs/text"},
        "method": {"$ref": "#/$defs/text"},
        "findings": {"$ref": "#/$defs/text"},
        "limitations": {"$ref": "#/$defs/text"},
        "practical_value": {"$ref": "#/$defs/text"},
        "sources": {"$ref": "#/$defs/sources"}
      }
    },
    "discussion": {
      "type": "object", "additionalProperties": false,
      "description": "Version 2 uses title/url/sources/tags only; explanatory fields are for legacy version 1.",
      "required": ["title", "url", "sources"],
      "properties": {
        "tags": {"$ref": "#/$defs/tags"},
        "title": {"$ref": "#/$defs/text"},
        "url": {"$ref": "#/$defs/url"},
        "summary": {"$ref": "#/$defs/text"},
        "significance": {"$ref": "#/$defs/text"},
        "caveat": {"$ref": "#/$defs/text"},
        "sources": {"$ref": "#/$defs/sources"}
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "url", "published", "category", "summary", "impact", "sources"],
      "properties": {
        "tags": {"$ref": "#/$defs/tags"},
        "title": {"$ref": "#/$defs/text"},
        "url": {"$ref": "#/$defs/url"},
        "published": {"type": "string", "format": "date"},
        "category": {"$ref": "#/$defs/text"},
        "summary": {"$ref": "#/$defs/text"},
        "impact": {"$ref": "#/$defs/text"},
        "sources": {"$ref": "#/$defs/sources"}
      }
    }
  }
}
